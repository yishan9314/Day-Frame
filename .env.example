# Optional email bridge. Empty means notifications are NOT sent.
DAYFRAME_NOTIFY_WEBHOOK_URL=
DAYFRAME_NOTIFY_BEARER_TOKEN=
DAYFRAME_EMAIL_FROM=
# Public base URL used in notification text; set HTTPS address after deployment.
DAYFRAME_PUBLIC_BASE_URL=http://127.0.0.1:4318
# Existing local service configuration:
DAYFRAME_PORT=4318
